{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "defileviz",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../defileViz",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "viewer",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "logs/viewer"
      ],
      "port": 8765
    }
  ]
}